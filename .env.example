# Copy to .env and adjust locally. Never commit real secrets.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=samosa_junction
DB_USERNAME=samosa
DB_PASSWORD=samosa

SERVER_PORT=8080

# HS256 requires at least 32 bytes. Override in any non-local environment.
JWT_SECRET=local-dev-only-change-me-32bytes-min-key!
JWT_EXPIRATION=24h

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379
CART_TTL=7d
CART_MAX_QUANTITY=20

# Off by default so spring-boot:run works without a broker. Enable after `docker compose up -d`.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=samosa.domain-events

# Off by default: files go to data/object-storage with HMAC GET URLs.
# Enable after `docker compose up -d` to use MinIO (S3-compatible).
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
# When the API runs in Compose, S3_ENDPOINT is http://minio:9000 and this stays localhost
# so the browser can open the presigned URL.
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=samosa-junction
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
S3_PRESIGN_TTL=15m
S3_MAX_FILE_BYTES=5000000
S3_MAX_COMPLAINT_IMAGES=5
S3_LOCAL_ROOT=data/object-storage
S3_PUBLIC_BASE_URL=http://localhost:8080
S3_SIGNING_KEY=local-dev-object-signing-key-32b!


# Samosa AI via OpenRouter (chat + embeddings). Leave empty for local tool fallback.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
